# Copy to .env.local to override the defaults in .env.development (npm run dev) and
# .env.staging (npm run build:staging). A production build needs these in its environment.
# The API's full address, ending in /api/v1. Builds fail without it.
VITE_API_URL=https://careerline-api.onrender.com/api/v1
# Shown on the Contact page; a card with no value is hidden
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
